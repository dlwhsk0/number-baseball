{
  "name": "number-baseball-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "숫자 야구 온라인 턴제 대결 서버 (Socket.IO)",
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "ignoredBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
