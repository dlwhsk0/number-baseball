# 서버 환경 변수(참고용). pm2로 실행 시 아래 값을 명령 앞에 붙이거나 ecosystem 파일에 넣는다.
# 포트(기본 3001). 리버스프록시(Dokploy/Traefik)가 이 포트로 프록시한다.
PORT=3001
# 허용 오리진(쉼표로 여러 개). 배포 시 프론트 도메인만 지정.
# 개발/테스트 중엔 비워두면 전체 허용(*).
CORS_ORIGIN=https://number-baseball-chi.vercel.app
# 결과 발표 텀(ms). 추측 후 양쪽에 결과를 보여주는 시간.
REVEAL_MS=1900
# --- 관측(메트릭·로그) ---
# 로그 레벨(pino, 기본 info). trace/debug/info/warn/error.
LOG_LEVEL=info
# /metrics 접근 토큰(선택). 설정 시 `Authorization: Bearer <값>` 또는 `?token=<값>` 필요.
# 비워두면 /metrics 공개(내부망/Prometheus 스크레이프용).
METRICS_TOKEN=
