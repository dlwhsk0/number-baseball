# 필수 — 디스코드 채널 설정 → 연동 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# 선택(기본값)
TARGET_URL=https://homerun.techeer.cloud-yaho.cloud
INTERVAL_S=30
FAIL_THRESHOLD=2
TIMEOUT_MS=8000
REMIND_MIN=30
# 내 계정 멘션(폰 푸시) — 디스코드 개발자 모드 켜고 내 프로필 → 사용자 ID 복사
DISCORD_MENTION=<@123456789012345678>
NOTIFY_ON_START=1
